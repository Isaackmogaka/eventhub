generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ATTENDEE
  ORGANIZER
  ADMIN
}

enum EventStatus {
  DRAFT
  PUBLISHED
  CANCELLED
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  name         String
  role         Role     @default(ATTENDEE)
  avatarUrl    String?
  phone        String?
  bio          String?
  location     String?
  latitude     Float?
  longitude    Float?
  createdAt    DateTime @default(now())

  organizer Organizer?
  holds     TicketHold[]
  payments  Payment[]
  tickets   Ticket[]
}

model Organizer {
  id                 String   @id @default(uuid())
  userId             String   @unique
  user               User     @relation(fields: [userId], references: [id])
  stripeAccountId    String?
  onboardingComplete Boolean  @default(false)
  createdAt          DateTime @default(now())

  events Event[]
}

model Event {
  id           String      @id @default(uuid())
  organizerId  String
  organizer    Organizer   @relation(fields: [organizerId], references: [id])
  title        String
  description  String?
  category     String?
  location     String?
  latitude     Float?
  longitude    Float?
  isOnline     Boolean     @default(false)
  startsAt     DateTime
  priceCents   Int
  totalTickets Int
  ticketsSold  Int         @default(0)
  status       EventStatus @default(DRAFT)
  createdAt    DateTime    @default(now())

  holds        TicketHold[]
  payments     Payment[]
  tickets      Ticket[]
}

enum HoldStatus {
  ACTIVE
  CONVERTED
  EXPIRED
  CANCELLED
}

model TicketHold {
  id         String     @id @default(uuid())
  eventId    String
  event      Event      @relation(fields: [eventId], references: [id])
  userId     String
  user       User       @relation(fields: [userId], references: [id])
  quantity   Int
  status     HoldStatus @default(ACTIVE)
  expiresAt  DateTime
  createdAt  DateTime   @default(now())

  payment    Payment?
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
}

model Payment {
  id            String        @id @default(uuid())
  holdId        String        @unique
  hold          TicketHold    @relation(fields: [holdId], references: [id])
  userId        String
  user          User          @relation(fields: [userId], references: [id])
  eventId       String
  event         Event         @relation(fields: [eventId], references: [id])
  amountCents   Int
  phoneNumber   String
  invoiceId     String?       @unique
  status        PaymentStatus @default(PENDING)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  ticket        Ticket?
}

enum TicketStatus {
  CONFIRMED
  CANCELLED
  CHECKED_IN
}

model Ticket {
  id            String       @id @default(uuid())
  eventId       String
  event         Event        @relation(fields: [eventId], references: [id])
  userId        String
  user          User         @relation(fields: [userId], references: [id])
  paymentId     String       @unique
  payment       Payment      @relation(fields: [paymentId], references: [id])
  quantity      Int
  qrCode        String       @unique
  status        TicketStatus @default(CONFIRMED)
  checkedInAt   DateTime?
  createdAt     DateTime     @default(now())
}
